{
  "name": "eticket-system",
  "version": "1.0.0",
  "description": "Full-stack Movie E-Ticket Management System with Host UPI QR Gateway and Multi-Role Portals",
  "main": "backend/server.js",
  "scripts": {
    "server": "node backend/server.js",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "install:all": "npm install && npm --prefix frontend install",
    "postinstall": "npm --prefix frontend install",
    "start": "node backend/server.js",
    "test": "node --test tests/unit.test.js tests/integration.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "keywords": [
    "e-ticket",
    "cinema",
    "movie-booking",
    "upi-qr",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
